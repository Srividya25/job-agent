# Copy to .env and fill in what you use. Everything is optional except
# Telegram if you want the propose/approve flow on your phone.

# --- Telegram (the approval channel) ------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional second chat for the ranked job lists (create a group, add the
# bot, put that group's chat id here). The main chat then carries only form
# questions, reviews, and submissions. Leave empty for everything in one.
TELEGRAM_JOBS_CHAT_ID=

# --- Tier 3 LLM (answers novel form questions; always reviewed by you) ---
# auto = try Claude first, fall back to a local Ollama model. Also: anthropic,
# qwen, off. `job-agent llm use <provider>` writes this for you.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.6:latest

# --- Job discovery (optional sources) ------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jobtracker sync (optional; Supabase-backed tracker) ------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# --- Confirmation-email checking (optional) -------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
